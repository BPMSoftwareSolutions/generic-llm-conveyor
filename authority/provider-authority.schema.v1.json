{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./authority/provider-authority.schema.v1.json",
  "title": "Provider Authority",
  "description": "Declares a provider configuration, its adapter, its credential reference, and the semantic model aliases it can resolve. Credentials are referenced, never stored.",
  "type": "object",
  "required": [
    "providerAuthorityId",
    "providerKind",
    "adapterId",
    "credentialReference",
    "endpointAuthority",
    "modelAliases",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "providerAuthorityId": { "type": "string", "minLength": 1 },
    "providerKind": {
      "enum": ["gemini", "openai", "anthropic", "litellm", "llamacpp"]
    },
    "adapterId": { "type": "string", "minLength": 1 },
    "credentialReference": {
      "type": "object",
      "required": ["source", "name"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "environment" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "endpointAuthority": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["provider-default", "explicit"] },
        "endpoint": { "type": "string", "format": "uri" }
      },
      "if": { "properties": { "mode": { "const": "explicit" } } },
      "then": { "required": ["mode", "endpoint"] }
    },
    "modelAliases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["resolvedModel", "supportedInteractionModes"],
        "additionalProperties": false,
        "properties": {
          "resolvedModel": { "type": "string", "minLength": 1 },
          "supportedInteractionModes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["text-generation", "structured-generation"]
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "supportsUsageReporting",
        "supportsStructuredOutput",
        "supportsStreaming"
      ],
      "additionalProperties": false,
      "properties": {
        "supportsUsageReporting": { "type": "boolean" },
        "supportsStructuredOutput": { "type": "boolean" },
        "supportsStreaming": { "type": "boolean" }
      }
    }
  }
}
