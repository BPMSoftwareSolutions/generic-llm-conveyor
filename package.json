{
  "name": "generic-llm-connector",
  "version": "0.1.0",
  "description": "Obtain one normalized model response under an explicitly resolved provider, model, request, execution policy, and evidence policy.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./src/index.ts",
  "bin": {
    "llm-connector": "./bin/llm-connector.ts",
    "authority-conveyor": "./bin/authority-conveyor.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter spec tests/acceptance/obtains-model-response.steps.test.ts tests/conformance/enforces-connector-conformance.test.ts tests/adapters/verifies-provider-adapter-contract.test.ts tests/conveyor/enforces-generic-conveyor-boundaries.test.ts",
    "test:acceptance": "node --import tsx --test --test-reporter spec tests/acceptance/obtains-model-response.steps.test.ts",
    "test:conformance": "node --import tsx --test --test-reporter spec tests/conformance/enforces-connector-conformance.test.ts",
    "test:adapters": "node --import tsx --test --test-reporter spec tests/adapters/verifies-provider-adapter-contract.test.ts",
    "test:conveyor": "node --import tsx --test --test-reporter spec tests/conveyor/proves-projector-only-code-origin.test.ts",
    "obtain": "node --import tsx ./bin/llm-connector.ts obtain",
    "conveyor:demo": "node --import tsx ./bin/authority-conveyor.ts --intent ./demonstrations/projects-greeting-capability.intent.json --provider-authority ./config/provider-authority.json --output-root ./generated/conveyor-demo",
    "conveyor:resume": "node --import tsx ./bin/authority-conveyor.ts --intent ./demonstrations/projects-greeting-capability.intent.json --provider-authority ./config/provider-authority.json --output-root ./generated/conveyor-demo --resume"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
